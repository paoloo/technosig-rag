# Never commit the token. ADS requires Authorization: Bearer for metadata search.
ADS_API_TOKEN=
ADS_QUERY=abs:(SETI OR Technosignature)
ADS_DATABASE_FILTER=database: astronomy
VECTOR_DATA_DIR=/mnt/raid1/paolo_tests/tecnosig
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
GENERATION_MODEL=qwen2.5:14b-instruct
RERANK_MODEL=
RERANK_REVISION=
RERANK_BACKEND=ollama
RERANK_DEVICE=cpu
RERANK_BATCH_SIZE=8
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_ALLOWED_HOSTS=127.0.0.1:8000,localhost:8000
MCP_ALLOWED_ORIGINS=
